# Copy to ~/.config/blogger/dev.env (outside the repo) and fill in the values.
# Use a SEPARATE dev Slack app and a dev channel such as #news-dev.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_OWNER_USER_ID=
# Optional. Without it, the Mac's own claude login is used.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional overrides.
BLOGGER_TIME_ZONE=Asia/Tbilisi
BLOGGER_BACKENDS=claude,codex
BLOGGER_LOG_LEVEL=debug
